{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // The pair the pinned Flutter OHOS fork template is tested with.
        // hvigor resolves compatibleSdkVersion against the SDK Manager, so
        // deriving or re-stamping these fails the build (00303082);
        // .github/actions/prepare-ohos-build refuses drift.
        "compatibleSdkVersion": "5.0.5(17)",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "profile"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
