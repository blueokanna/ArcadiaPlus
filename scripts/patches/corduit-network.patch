+
+    impl Read for Fragmented {
+        fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+            if self.fragmented {
+                self.pause = !self.pause;
+                if self.pause {
+                    return Err(ErrorKind::TimedOut.into());
+                }
+                let n = buf.len().min(1);
+                self.bytes.read(&mut buf[..n])
+            } else {
+                self.bytes.read(buf)
+            }
+        }
+    }
+    impl Write for Fragmented {
