<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.blueokanna.arcadiaplus.validationprobe">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application android:label="ArcadiaPlus Validation" android:debuggable="true" android:allowBackup="false">
        <activity android:name="org.arcadia.validation.ProbeActivity" android:exported="false" android:excludeFromRecents="true" />
        <service android:name="org.arcadia.validation.ProbeService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User initiated VPN network verification" />
        </service>
    </application>
    <instrumentation android:name="org.arcadia.validation.NetworkProbe" android:targetPackage="com.blueokanna.arcadiaplus.validationprobe" android:label="VPN network verification" />
</manifest>
